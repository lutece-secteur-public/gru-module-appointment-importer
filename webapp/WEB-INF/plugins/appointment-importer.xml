<?xml version="1.0" encoding="UTF-8"?>
<plug-in>
    <name>appointment-importer</name>
    <class>fr.paris.lutece.portal.service.plugin.PluginDefaultImplementation</class>
    <version>2.0.0-SNAPSHOT</version>
    <description>module.appointment.importer.module.description</description>
    <provider>City of Paris</provider>
    <provider-url>https://lutece.paris.fr</provider-url>
    <icon-url>themes/shared/plugins/appointment/images/admin/appointment.svg</icon-url>
    <copyright>City of Paris</copyright>
    <db-pool-required>1</db-pool-required>

    <core-version-dependency>
        <min-core-version>8.0.0</min-core-version>
        <max-core-version/>
    </core-version-dependency>

    <admin-features>
        <admin-feature>
            <feature-id>APPOINTMENT_IMPORT</feature-id>
            <feature-title>module.appointment.importer.adminFeature.name</feature-title>
            <feature-description>module.appointment.importer.adminFeature.description</feature-description>
            <feature-level>0</feature-level>
            <feature-url>jsp/admin/plugins/appointment/modules/importer/ManageAppointmentImport.jsp</feature-url>
            <feature-group>APPLICATIONS</feature-group>
            <feature-icon-url/>
        </admin-feature>
    </admin-features>

    <admin-css-stylesheets>
        <admin-css-stylesheet>css/admin/plugins/appointment/modules/importer/appointment-importer.css</admin-css-stylesheet>
    </admin-css-stylesheets>

    <daemons>
        <daemon>
            <daemon-id>appointmentImportDaemon</daemon-id>
            <daemon-name>module.appointment.importer.daemon.name</daemon-name>
            <daemon-description>module.appointment.importer.daemon.description</daemon-description>
            <daemon-class>fr.paris.lutece.plugins.appointment.modules.importer.service.AppointmentImportDaemon</daemon-class>
        </daemon>
        <daemon>
            <daemon-id>appointmentImportPurgeDaemon</daemon-id>
            <daemon-name>module.appointment.importer.daemon.purge.name</daemon-name>
            <daemon-description>module.appointment.importer.daemon.purge.description</daemon-description>
            <daemon-class>fr.paris.lutece.plugins.appointment.modules.importer.service.AppointmentImportPurgeDaemon</daemon-class>
        </daemon>
    </daemons>

</plug-in>
